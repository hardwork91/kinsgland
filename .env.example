# Configuración de Firebase (opcional).
# Copia este archivo a `.env` y rellena con los datos de tu proyecto Firebase.
# Si lo dejas vacío, la app funciona con la API en memoria (single-device).
#
# Requisitos en la consola de Firebase:
#   - Realtime Database habilitada
#   - Authentication > Sign-in method > Anonymous: activado
#
# Encuentra estos valores en: Configuración del proyecto > Tus apps > SDK config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
